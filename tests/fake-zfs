#!/usr/bin/env bash
# Fake `zfs` for testing zfs-hold-tight without a real pool.
# Driven by fixture files under $FAKE_ZFS_DIR:
#   snaps    one per line: name<TAB>keep_until<TAB>tier   (use - for empty)
#   holds    one per line: name<TAB>tag<TAB>timestamp
#   dsprops  one per line: dataset<TAB>property<TAB>value -- dataset-LEVEL properties
#            (e.g. <ns>:pruned_through), keyed by dataset since one FAKE_ZFS_DIR can
#            hold fixtures for more than one dataset (see T18's per-dataset isolation).
#   ops.log  appended: every mutating op (set/hold/release/destroy/inherit)
# $FAKE_ZFS_FAIL may name a subcommand to force-fail (e.g. "set").
set -u
D="$FAKE_ZFS_DIR"
sub="${1:-}"; shift || true
log() { echo "$*" >> "$D/ops.log"; }
# update_snap_field <snap> <col> <val>: set column <col> (2=keep_until, 3=tier) of the
# matching $D/snaps line to <val> — the shared persistence mechanism `set` and `inherit`
# both use, so `zfs list` in a later invocation sees the mutation (needed to test
# multi-run transitions: establishment carrying forward, demotion actually clearing).
update_snap_field() {
  local snap="$1" col="$2" val="$3"
  [ -f "$D/snaps" ] || return 0
  awk -F'\t' -v OFS='\t' -v snap="$snap" -v col="$col" -v val="$val" \
    '$1==snap{$col=val} {print}' "$D/snaps" > "$D/snaps.tmp" && mv "$D/snaps.tmp" "$D/snaps"
}
[ "${FAKE_ZFS_FAIL:-}" = "$sub" ] && { echo "fake: forced failure on $sub" >&2; exit 1; }
case "$sub" in
  list)
    [ -n "${FAKE_ZFS_SLEEP:-}" ] && sleep "$FAKE_ZFS_SLEEP"
    ds="${@: -1}"
    awk -F'\t' -v p="$ds@" 'index($1,p)==1{print}' "$D/snaps" 2>/dev/null
    exit 0 ;;
  holds)
    hdr=1; for x in "$@"; do case "$x" in -*H*) hdr=0;; esac; done   # -H suppresses the header
    [ "$hdr" = 1 ] && printf 'NAME\tTAG\tTIMESTAMP\n'
    [ -f "$D/holds" ] && cat "$D/holds"
    exit 0 ;;
  set)
    log "set $*"
    # `set <prop=val>... <target>` — persist keep_until/tier writes on a snapshot target
    # back into $D/snaps (via update_snap_field above), so a later invocation's `list`
    # sees them (needed to test multi-run transitions, e.g. cold-start establishment
    # carrying into a later run). A DATASET target (no `@`) persists into $D/dsprops
    # instead, keyed by (dataset, property) -- this is how pruned_through round-trips.
    args=("$@"); n=${#args[@]}
    if [ "$n" -gt 0 ]; then
      target="${args[$((n-1))]}"
      case "$target" in
        *@*)
          for ((i=0; i<n-1; i++)); do
            case "${args[$i]}" in
              *:keep_until=*) update_snap_field "$target" 2 "${args[$i]#*:keep_until=}" ;;
              *:tier=*)       update_snap_field "$target" 3 "${args[$i]#*:tier=}" ;;
            esac
          done ;;
        *)
          for ((i=0; i<n-1; i++)); do
            case "${args[$i]}" in
              *=*)
                p="${args[$i]%%=*}"; v="${args[$i]#*=}"
                esc_t=$(printf '%s' "$target" | sed 's/[.[\*^$]/\\&/g')
                esc_p=$(printf '%s' "$p" | sed 's/[.[\*^$]/\\&/g')
                [ -f "$D/dsprops" ] && grep -vP "^${esc_t}\t${esc_p}\t" "$D/dsprops" > "$D/dsprops.tmp" 2>/dev/null \
                  && mv "$D/dsprops.tmp" "$D/dsprops"
                printf '%s\t%s\t%s\n' "$target" "$p" "$v" >> "$D/dsprops"
                ;;
            esac
          done ;;
      esac
    fi
    exit 0 ;;
  get)
    # `get -Hp -o value <prop> <target>` — dataset-level property read, single value only
    # (the only form zfs-hold-tight.cs actually uses). Never-set -> "-", matching real zfs.
    args=("$@"); n=${#args[@]}
    target="${args[$((n-1))]}"; prop=""; skip_next=0
    for ((i=0; i<n-1; i++)); do
      a="${args[$i]}"
      if [ "$skip_next" = 1 ]; then skip_next=0; continue; fi
      case "$a" in
        -o) skip_next=1 ;;
        -*) ;;
        *) prop="$a" ;;
      esac
    done
    val="-"
    if [ -f "$D/dsprops" ]; then
      val="$(awk -F'\t' -v d="$target" -v p="$prop" '$1==d && $2==p{print $3; f=1} END{if(!f) print "-"}' "$D/dsprops")"
    fi
    echo "$val"
    exit 0 ;;
  inherit)
    log "inherit $1 $2"
    # `inherit <prop> <snap>` — mirror of the `set` persistence above: clear the matching
    # column back to "-" in $D/snaps, so a later invocation's `list` sees the demotion
    # (needed to let a multi-run test actually catch a broken demotion/inherit path,
    # instead of `list` keeping stale keep_until/tier from before the inherit).
    case "$1" in
      *:keep_until) update_snap_field "$2" 2 "-" ;;
      *:tier)       update_snap_field "$2" 3 "-" ;;
    esac
    exit 0 ;;
  hold)
    # `hold <tag> <snap>...` — may carry multiple snapshots
    tag="$1"; shift
    for s in "$@"; do log "hold $tag $s"; printf '%s\t%s\t-\n' "$s" "$tag" >> "$D/holds"; done
    exit 0 ;;
  release)
    log "release $1 $2"
    if [ -f "$D/holds" ]; then
      grep -vP "^$(printf '%s' "$2" | sed 's/[.[\*^$]/\\&/g')\t$(printf '%s' "$1" | sed 's/[.[\*^$]/\\&/g')\t" "$D/holds" > "$D/holds.tmp" || true
      mv "$D/holds.tmp" "$D/holds"
    fi
    exit 0 ;;
  destroy)
    # refuse if held (like real zfs)
    if [ -f "$D/holds" ] && grep -qP "^$(printf '%s' "$1" | sed 's/[.[\*^$]/\\&/g')\t" "$D/holds"; then
      echo "cannot destroy '$1': snapshot is busy (held)" >&2; exit 1
    fi
    log "destroy $1"
    grep -vP "^$(printf '%s' "$1" | sed 's/[.[\*^$]/\\&/g')\t" "$D/snaps" > "$D/snaps.tmp" || true
    mv "$D/snaps.tmp" "$D/snaps"
    exit 0 ;;
  *) echo "fake zfs: unknown subcommand '$sub'" >&2; exit 2 ;;
esac
